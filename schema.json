  "trustStates": ["unknown", "candidate", "tested", "validated", "deprecated"],
  "requiredFields": [
    "id",
    "name",
    "trust",
    "detection",
    "interaction",
    "completionCheck",
    "submission",
    "version",
    "lastValidated"
  ],
