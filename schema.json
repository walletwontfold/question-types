      "methods": ["click", "type", "drag", "select", "highlight"],
      "sequence": ["ordered steps as strings"],
      "elementStrategies": ["how to find the right control"]
    },
    "completionCheck": {
      "required": true,
      "checks": ["observable state checks before submit"],
      "incompleteSignals": ["text or DOM signals of incomplete"]
    },
    "submission": {
      "buttonSelectors": ["submit button selectors"],
      "preSubmitVerify": true,
      "maxSubmitAttempts": 2
    },
    "recovery": {
      "onIncomplete": ["steps"],
      "maxRecoveryAttempts": 2
    },
    "failureModes": ["common failures"],
